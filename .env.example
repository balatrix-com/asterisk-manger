PJSIP_CONFIG_PATH=/etc/asterisk/pjsip.conf
EXTENSIONS_CONFIG_PATH=/etc/asterisk/extensions.conf
BACKUP_DIRECTORY=/var/backups/asterisk-config-manager
ASTERISK_BINARY=/usr/sbin/asterisk
ASTERISK_SERVICE_NAME=asterisk
SECRET_KEY=replace-with-at-least-32-random-bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_TTL_SECONDS=1800
FILE_OWNER=asterisk
FILE_GROUP=asterisk
FILE_MODE=0640
AUDIT_LOG_PATH=/var/log/asterisk-config-manager/audit.jsonl
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=
AMI_SECRET=
DIALER_ENDPOINT=
